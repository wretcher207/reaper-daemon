# Drums under the E jam — RS Monarch. v4: open intro (bars 1-2) breathes under the
# ringing guitar intro, then DOUBLE BASS slams in with the muted chug riff (bar 3).
# Lift switches to crashes; bar 8 tom fill. No ride anywhere.
@tempo 120
@map RS Monarch

# bars 1-2 — OPEN intro: big crash + open hats, half-time kick, let it breathe
[intro] bars=2
grid 16
kick  | X.......X....... |
snare | ....X.......X... |
hat_o | X...X...X...X... |
crash | X............... X............... |

# bars 3-4 — the chug riff hits: DOUBLE BASS doubles the guitar, open hats
[chug] bars=2
grid 16
kick  | Xxx.Xx.xXx.xXxx. |
snare | ....X.......X... |
hat_o | x.x.x.x.x.x.x.x. |

# bars 5-6 — lift: crashes each downbeat, hats shimmer on the offbeats
[lift] bars=2
grid 16
kick  | X...X...X...X... |
snare | ....X.......X... |
hat_o | ..x...x...x...x. |
crash | X............... X............... |

# bar 7 — double bass returns, crash the downbeat
[b7] bars=1
grid 16
kick  | Xxx.Xx.xXx.xXxx. |
snare | ....X.......X... |
hat_o | x.x.x.x.x.x.x.x. |
crash | X............... |

# bar 8 — descending tom-doubles fill into a crash+kick resolve
[b8] bars=1
grid 16
kick  | X...X..........X |
snare | ....X........... |
tom1  | ........xx...... |
tom2  | ..........xx.... |
tom3  | ............xx.. |
tom4  | ..............x. |
crash | ...............X |
